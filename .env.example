# Piyush Agro Industries - Local Environment Variables
# Copy this file to .env.local and populate with your own project credentials.
# NOTE: Never commit .env.local or expose secret keys in client-side code.

# Supabase Configuration (Required)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Website Canonical Domain URL
NEXT_PUBLIC_SITE_URL=https://www.piyushagroindustries.in

# Optional: Transactional Email Notification Service (Resend)
# Used by /api/quote route for email alerts on new inquiries
# RESEND_API_KEY=re_your_api_key_here
# QUOTE_RECEIVER_EMAIL=piyushagroindustries2016@gmail.com
# SMTP_FROM=quotes@piyushagroindustries.in
